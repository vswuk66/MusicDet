# Application settings
APP_NAME=music-genre-classifier
APP_ENV=development
DEBUG=true

# Server settings
HOST=0.0.0.0
PORT=8000

# Authentication
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Model paths (relative to project root)
MODEL_PATH=model/genre_classifier_cnn_gtzan.h5
GENRE_MAPPING_PATH=genre_mapping.json

# Audio processing
SAMPLE_RATE=22050
TRACK_DURATION_SECONDS=29
NUM_SEGMENTS=10

# Logging
LOG_LEVEL=INFO

# Vector database (PostgreSQL + pgvector)
ENABLE_VECTOR_DB=false
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/musicdet
EMBEDDING_DIM=128
